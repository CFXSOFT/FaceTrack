# Cadena de conexión DIRECTA a Postgres (Supabase → Settings → Database →
# Connection string → "Transaction pooler", puerto 6543 -- ese modo es el
# pensado para funciones serverless/de vida corta como las de Vercel).
# Formato: postgresql://postgres.xxxxx:[TU-PASSWORD]@aws-0-xxxx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Generar UNA VEZ con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_clave_aqui'))"
# y pegar el resultado completo aquí (nunca la clave en texto plano).
DEV_PASSWORD_HASH=

# Opcional, recomendado: una frase larga y aleatoria, fija, para que la
# sesión no se cierre en cada reinicio/cold start de Vercel.
FOCUS_SECRET_KEY=
